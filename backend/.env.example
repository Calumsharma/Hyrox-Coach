# Copy to backend/.env for local development, or set these as real environment variables
# in your deployment host (e.g. Railway's service Variables tab). Never commit a real .env.

# Local dev default shown; on a deployed host with a persistent volume this should point at a
# file inside that volume (e.g. sqlite:////data/hyrox_coach.db) so the database survives
# redeploys and restarts — a container's own filesystem is ephemeral.
DATABASE_URL=sqlite:///./hyrox_coach.db

# Required in any real deployment. Generate a real random value — never reuse the
# "dev-secret-change-me" default outside local development.
JWT_SECRET=dev-secret-change-me

# Optional — only needed once the AI-coach / wearable-aggregator features are wired in.
ANTHROPIC_API_KEY=
TERRA_API_KEY=
TERRA_DEV_ID=
